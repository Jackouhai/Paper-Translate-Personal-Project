# Triton compiles CUDA driver helpers when vLLM starts, so the CUDA development
# headers are required in addition to the runtime libraries.
# syntax=docker/dockerfile:1

FROM nvidia/cuda:12.8.1-cudnn-devel-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive \
    UV_PYTHON=python3.10 \
    UV_PROJECT_ENVIRONMENT=/app/services/llm-server/.venv \
    UV_HTTP_TIMEOUT=300 \
    UV_HTTP_RETRIES=5 \
    UV_CONCURRENT_DOWNLOADS=4 \
    PATH=/app/services/llm-server/.venv/bin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        libgomp1 \
        python3.10 \
        python3.10-venv \
        build-essential \
        python3.10-dev \
    && rm -rf /var/lib/apt/lists/*

COPY --from=ghcr.io/astral-sh/uv:0.11.32 /uv /uvx /bin/

WORKDIR /app/services/llm-server
COPY services/llm-server/pyproject.toml services/llm-server/uv.lock ./
RUN --mount=type=cache,id=pp-doclayout-vllm-uv-cache,target=/root/.cache/uv \
    uv sync --frozen --no-dev --no-install-project

WORKDIR /app
COPY scripts/start_paddle_ocr_vl.sh scripts/start_translate_gemma.sh ./scripts/
RUN chmod +x scripts/start_paddle_ocr_vl.sh scripts/start_translate_gemma.sh

ENV UV_NO_SYNC=1 \
    HF_HOME=/models/huggingface
