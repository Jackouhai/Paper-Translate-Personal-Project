# Docker profile for an NVIDIA RTX 3060 12 GB VPS.
# Copy to .env.vps, then use: docker compose --env-file .env.vps ...
# This profile trades throughput for reliable VRAM headroom while both vLLM
# servers are resident. It does not change the default local Docker profile.

# TranslateGemma: 4-bit BitsAndBytes is supported on Ampere GPUs.
TRANSLATE_GEMMA_QUANTIZATION=bitsandbytes
TRANSLATE_GEMMA_DTYPE=bfloat16
TRANSLATE_GEMMA_KV_CACHE_DTYPE=auto
TRANSLATE_GEMMA_MAX_MODEL_LEN=4096
TRANSLATE_GEMMA_MAX_NUM_SEQS=4
TRANSLATE_GEMMA_MAX_BATCHED_TOKENS=4096
TRANSLATE_GEMMA_GPU_MEMORY_UTILIZATION=0.6
TRANSLATE_GEMMA_ENFORCE_EAGER=1
# Set to 1 only if Gemma still cannot start; it uses host RAM and lowers speed.
TRANSLATE_GEMMA_CPU_OFFLOAD_GB=0

# PaddleOCR-VL receives enough memory for its initial profile and a small cache.
PADDLE_OCR_VL_MAX_MODEL_LEN=8192
PADDLE_OCR_VL_MAX_NUM_SEQS=8
PADDLE_OCR_VL_MAX_BATCHED_TOKENS=8192
PADDLE_OCR_VL_GPU_MEMORY_UTILIZATION=0.25
PARSE_API_DEVICE=cpu
PADDLE_OCR_MERGE_LAYOUT_BLOCKS=false
WEB_DEMO_TRANSLATION_WORKERS=1
WEB_DEMO_MAX_CONCURRENT_REQUESTS=4
WEB_FRONTEND_HOST_IP=0.0.0.0
WEB_FRONTEND_HOST_PORT=3000
