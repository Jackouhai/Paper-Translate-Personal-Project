{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "PaperTranslate",
  "version": "0.1.0",
  "identifier": "com.jackouhai.papertranslate",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "PaperTranslate",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "../../desktop-runtime": "runtime",
      "../../backend/app.py": "backend-app/app.py",
      "../../backend/run_backend.py": "backend-app/run_backend.py",
      "../../backend/services/pipeline_service.py": "backend-app/services/pipeline_service.py",
      "../../backend/services/__init__.py": "backend-app/services/__init__.py"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
