# Conservative profile for a single NVIDIA GPU with about 24 GB VRAM.
# Copy to .env.24gb before using scripts/start_24gb_demo.sh.

TRANSLATE_GEMMA_QUANTIZATION=fp8
TRANSLATE_GEMMA_DTYPE=auto
TRANSLATE_GEMMA_KV_CACHE_DTYPE=fp8
TRANSLATE_GEMMA_MAX_MODEL_LEN=4096
TRANSLATE_GEMMA_MAX_NUM_SEQS=16
TRANSLATE_GEMMA_MAX_BATCHED_TOKENS=16384
TRANSLATE_GEMMA_GPU_MEMORY_UTILIZATION=0.8
TRANSLATE_GEMMA_ENFORCE_EAGER=0
TRANSLATE_GEMMA_CPU_OFFLOAD_GB=0

PADDLE_OCR_VL_MAX_MODEL_LEN=8192
PADDLE_OCR_VL_MAX_NUM_SEQS=24
PADDLE_OCR_VL_MAX_BATCHED_TOKENS=12288
PADDLE_OCR_VL_GPU_MEMORY_UTILIZATION=0.20
PARSE_API_DEVICE=auto
PADDLE_OCR_MERGE_LAYOUT_BLOCKS=false

WEB_DEMO_TRANSLATION_WORKERS=5
WEB_DEMO_MAX_CONCURRENT_REQUESTS=6
WEB_FRONTEND_HOST_IP=0.0.0.0
WEB_FRONTEND_HOST_PORT=3000
